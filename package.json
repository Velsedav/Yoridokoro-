{
  "name": "yoridokoro",
  "version": "0.2.3",
  "description": "Yoridokoro — espace personnel pour étudier, agir, créer et entretenir ses relations.",
  "private": true,
  "author": {
    "name": "Velsedav"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config electron-vite.config.mjs",
    "build": "electron-vite build --config electron-vite.config.mjs",
    "preview": "electron-vite preview --config electron-vite.config.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder",
    "test": "vitest --maxWorkers=1",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:run && npm run build"
  },
  "build": {
    "appId": "com.velsedav.yoridokoro",
    "productName": "Yoridokoro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      {
        "from": "src/public",
        "to": "public"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "icons-dark-academia",
      "category": "Education"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon-dark-academia.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "yoridokoro-icon-source.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "installerIcon": "icon-dark-academia.ico",
      "uninstallerIcon": "icon-dark-academia.ico",
      "installerHeaderIcon": "icon-dark-academia.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "electron-auto-launch": "^5.0.5",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
